# Storage
STORAGE_BACKEND=memory

# InfluxDB
INFLUX_URL=http://localhost:8086
INFLUX_ORG=groundstation
INFLUX_BUCKET=telemetry
INFLUX_TOKEN=replace-me
INFLUX_INIT_USERNAME=admin
INFLUX_INIT_PASSWORD=replace-me

# Ground station location
# Replace these values with the coordinates of the station.
GROUND_STATION_LAT=0.0
GROUND_STATION_LON=0.0
GROUND_STATION_ALT_M=0

# Orbital data and satellite catalogue
TLE_URL=https://celestrak.org/NORAD/elements/gp.php?GROUP=cubesat&FORMAT=tle
TLE_REFRESH_HOURS=12
SATNOGS_TRANSMITTERS_URL=https://db.satnogs.org/api/transmitters/
SATNOGS_CACHE_PATH=data/transmitters.json
CATALOG_REFRESH_HOURS=12

# Automatic reception
AUTO_MIN_FREQUENCY_HZ=137000000
AUTO_MAX_FREQUENCY_HZ=470000000
AUTO_MAX_SATELLITES=40
MIN_ELEVATION_DEG=10
RECEIVER_START_MARGIN_SECONDS=120
RECEIVER_STOP_MARGIN_SECONDS=60

# AegisSat GMSK laboratory profile
AEGIS_GMSK_PROFILE=laboratory_default
AEGIS_GMSK_CENTER_FREQUENCY_HZ=437500000
AEGIS_GMSK_SYMBOL_RATE=9600
AEGIS_GMSK_SAMPLES_PER_SYMBOL=4
AEGIS_GMSK_BT=0.5
AEGIS_GMSK_FREQUENCY_DEVIATION_HZ=2400
AEGIS_RTL_GAIN_DB=30

# Receiver
RTL_DEVICE_INDEX=0
RTL_GAIN=30
DOPPLER_ENABLED=true
DOPPLER_UPDATE_SECONDS=1
SIGNAL_OFFSET_HZ=0
GR_SATELLITES_FLL_BW_HZ=0
GR_SATELLITES_F_OFFSET_HZ=0

# API and decoder interfaces
API_BASE_URL=http://127.0.0.1:8000
GR_SATELLITES_UDP_PORT=7355
GR_SATELLITES_KISS_PORT=8100
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Runtime directories
LOG_DIR=logs
IQ_RECORDING_DIR=data/iq
GENERIC_TELEMETRY_JSON_DIR=data/telemetry_json
